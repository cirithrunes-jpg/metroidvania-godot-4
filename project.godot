; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Metroidvania"
run/main_scene="res://menus/start_menu.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")
run/max_fps=120
config/icon="res://icon.svg"

[autoload]

Utils="*res://Utils.gd"
Events="*res://Events.gd"
PlayerStats="*res://player/player_stats.tscn"
MainInstances="*res://MainInstances.gd"
WorldStash="*res://WorldStash.gd"
Sound="*res://music_and_sounds/sound.tscn"
Music="*res://music_and_sounds/music.tscn"
SaveManager="*res://SaveManager.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://prototype/ui/readable_theme.tres"


